<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.systemtwin.ui.BuilderController"
      spacing="16" style="-fx-background-color: #0f172a;">
    <padding>
        <Insets top="16" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Component & Dependency Creation Controls -->
    <HBox spacing="16">
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Component ID:" style="-fx-text-fill: #94a3b8;"/>
            <TextField fx:id="compIdField" promptText="e.g. srv-01" prefWidth="100"/>
            <Label text="Name:" style="-fx-text-fill: #94a3b8;"/>
            <TextField fx:id="compNameField" promptText="e.g. Edge Server" prefWidth="130"/>
            <Label text="Type:" style="-fx-text-fill: #94a3b8;"/>
            <ComboBox fx:id="compTypeCombo" prefWidth="110"/>
            <Button text="+ Add Node" onAction="#handleAddComponent" styleClass="btn-primary"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="metric-card">
            <Label text="Dependent:" style="-fx-text-fill: #94a3b8;"/>
            <ComboBox fx:id="depSourceCombo" prefWidth="110"/>
            <Label text="Depends on:" style="-fx-text-fill: #94a3b8;"/>
            <ComboBox fx:id="depTargetCombo" prefWidth="110"/>
            <Button text="Link Edge" onAction="#handleAddDependency" styleClass="btn-secondary"/>
        </HBox>
    </HBox>

    <!-- Split Pane: Components vs Criticality Analysis -->
    <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="8" styleClass="metric-card">
            <Label text="REGISTERED COMPONENTS" styleClass="metric-card-title"/>
            <TableView fx:id="componentsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colName" text="Name" prefWidth="140"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                    <TableColumn fx:id="colState" text="State" prefWidth="90"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="8" styleClass="metric-card">
            <Label text="GRAPH CRITICALITY &amp; SPOF SCORING" styleClass="metric-card-title"/>
            <TableView fx:id="criticalityTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="critNameCol" text="Component" prefWidth="140"/>
                    <TableColumn fx:id="critScoreCol" text="Score (0-100)" prefWidth="90"/>
                    <TableColumn fx:id="critBlastCol" text="Blast Radius" prefWidth="90"/>
                    <TableColumn fx:id="critSpofCol" text="SPOF?" prefWidth="70"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>
